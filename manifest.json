{
  "manifest_version": 3,
  "name": "Google Local → CSV | Negocios",
  "short_name": "Locales a CSV",
  "version": "1.6.0",
  "description": "Busca negocios desde la extensión, extrae fichas de Google Maps y Locales, filtra resultados y exporta CSV.",
  "action": {
    "default_title": "Extraer negocios a CSV",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.google.com.ar/*",
    "https://*.google.com.br/*",
    "https://*.google.com.py/*",
    "https://*.google.es/*",
    "https://*.google.com.uy/*",
    "https://*.google.cl/*",
    "https://*.google.com.mx/*",
    "https://*.google.com.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.google.com.ar/*",
        "https://*.google.com.br/*",
        "https://*.google.com.py/*",
        "https://*.google.es/*",
        "https://*.google.com.uy/*",
        "https://*.google.cl/*",
        "https://*.google.com.mx/*",
        "https://*.google.com.co/*"
      ],
      "js": [
        "data_utils.js",
        "quick_whatsapp.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
